[Unit]
Description=Heptapod server agent
Documentation=https://github.com/heptapodwatch/heptapod/tree/main/agent
Wants=network-online.target
After=network-online.target

[Service]
ExecStart=/usr/local/bin/heptapod-agent
LoadCredential=token:/etc/heptapod-agent/token
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
RestrictSUIDSGID=yes
CapabilityBoundingSet=
# AF_NETLINK lists the interface addresses (a read-only route dump); the agent opens no other socket kinds.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
