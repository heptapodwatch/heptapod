    "version": "0.1.0",
    "type": "library",
    "license": "AGPL-3.0-or-later",
    "require": {
        "php": "^8.5",
        "illuminate/auth": "^13.34",
        "illuminate/cache": "^13.34",
        "illuminate/console": "^13.34",
        "illuminate/contracts": "^13.34",
        "illuminate/database": "^13.34",
        "illuminate/http": "^13.34",
        "illuminate/routing": "^13.34",
        "illuminate/support": "^13.34",
        "illuminate/validation": "^13.34",
        "inertiajs/inertia-laravel": "^3.5",
        "nesbot/carbon": "^3.14",
        "spatie/laravel-data": "^4.22",
