        "@commitlint/config-conventional": "^21.2.4",
        "@laravel/vite-plugin-wayfinder": "^0.1.11",
        "@rolldown/plugin-babel": "^0.3.1",
        "@testing-library/react": "^16.3.3",
        "@types/node": "^26.6.6",
        "babel-plugin-react-compiler": "^1.0.0",
        "jsdom": "^31.0.1",
        "lefthook": "^2.2.2",
        "playwright": "^1.65.1",
        "vite-plus": "1.3.0",
        "vitest": "5.0.5"
