{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "license": "AGPL-3.0-or-later",
    "type": "module",
    "scripts": {
        "build": "vp build",
        "build:ssr": "vp build && vp build --ssr",
        "dev": "vp dev",
        "check": "vp check",
        "contrast:check": "node scripts/contrast.mjs",
        "check:fix": "vp check --fix",
        "lint": "vp lint",
        "types:check": "tsc --noEmit",
        "test": "vitest run --passWithNoTests",
        "hooks:install": "sh scripts/install-hooks.sh"
    },
    "dependencies": {
        "@inertiajs/react": "^3.11.0",
        "@inertiajs/vite": "^3.11.0",
        "@laravel/echo-react": "^2.6.3",
