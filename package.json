        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "cn": "^0.5.2",
        "concurrently": "^10.0.7",
        "cronstrue": "^3.39.0",
        "i18next": "^27.2.2",
        "input-otp": "^1.4.2",
        "laravel-echo": "^2.6.3",
        "laravel-vite-plugin": "^3.2.1",
        "lucide-react": "^1.76.0",
        "pusher-js": "^8.6.0",
        "radix-ui": "^1.8.1",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-i18next": "^18.0.3",
