        "concurrently": {
            "shell-quote": "^1.12.0"
        },
        "oxfmt": {
            "tinypool": "^2.1.2"
        },
        "vite": "$vite",
        "vitest": "$vitest"
    },
    "commitlint": {
        "extends": [
            "@commitlint/config-conventional"
        ]
    }
}
