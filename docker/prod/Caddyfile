# HEPTAPOD_WEB_MODE picks how PHP serves the app. worker (default): Laravel Octane workers boot it once and keep it in
# memory; HEPTAPOD_WEB_WORKERS of them serve requests, the rest wait. classic: every request boots the app.
# REQUEST_MAX_EXECUTION_TIME is Octane's per-request limit (its max_execution_time), the same 30 s classic PHP applies.
(frankenphp-worker) {
    worker {
        file /app/public/frankenphp-worker.php
        num {$HEPTAPOD_WEB_WORKERS:4}
        env REQUEST_MAX_EXECUTION_TIME 30
    }
}
(frankenphp-classic) {
}
(php-worker) {
    index frankenphp-worker.php
}
(php-classic) {
}

{
    admin off
    http_port 8080
    https_port 8443
    auto_https disable_redirects
    frankenphp {
        import frankenphp-{$HEPTAPOD_WEB_MODE:worker}
    }
    # Capability URLs (invitations, password resets, email verification, cron pings) carry their secret in a
    # path segment or query value, in any percent-encoding. Both loggers keep query keys and
    # path segments shorter than 24 characters only; the Referer is dropped.
    log default {
        output stdout
        format filter {
            wrap json
            fields {
                request>uri regexp "([?&][^=&#]*=)[^&#]*|[^/?&=#]{24,}" "$1[redacted]"
                request>headers>Referer delete
                resp_headers>Location regexp "([?&][^=&#]*=)[^&#]*|[^/?&=#]{24,}" "$1[redacted]"
            }
        }
    }
}

# Loopback-only health endpoint works before DNS/ACME and does not redirect to TLS.
# It runs through the same serving path as the app, so readiness covers the worker pool in worker mode.
http://:8080 {
    header X-Content-Type-Options nosniff
    @health {
        path /up
        remote_ip 127.0.0.1 ::1
    }
    handle @health {
        root * /app/public
        php_server {
            import php-{$HEPTAPOD_WEB_MODE:worker}
        }
    }
    # External 443 maps to internal 8443; never leak the container port in redirects.
    handle {
        redir https://{host}{uri} permanent
    }
}

{$SERVER_NAME} {
    root * /app/public
    encode zstd gzip
    header X-Content-Type-Options nosniff
    # /agent is reserved for agent traffic, whose reports are at most 16 KiB (ingest contract v1): larger bodies on any
    # path below it (a trailing slash included, which Laravel would still route) are refused here, before PHP reads them.
    @agent path /agent /agent/*
    request_body @agent {
        max_size 16KiB
    }
    @reverb path /app/*
    handle @reverb {
        reverse_proxy reverb:8080
    }
    handle {
        php_server {
            import php-{$HEPTAPOD_WEB_MODE:worker}
        }
    }
    # Same filter as the global error logger above.
    log {
        output stdout
        format filter {
            wrap json
            fields {
                request>uri regexp "([?&][^=&#]*=)[^&#]*|[^/?&=#]{24,}" "$1[redacted]"
                request>headers>Referer delete
                resp_headers>Location regexp "([?&][^=&#]*=)[^&#]*|[^/?&=#]{24,}" "$1[redacted]"
            }
        }
    }
}
