        <testsuite name="Arch">
            <directory>tests/Arch</directory>
        </testsuite>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
            <directory>addons/uptime/tests</directory>
            <directory>addons/performance/tests</directory>
            <directory>addons/certificate_health/tests</directory>
            <directory>addons/cron/tests</directory>
            <directory>addons/dns/tests</directory>
            <directory>addons/application_health/tests</directory>
            <directory>addons/domain/tests</directory>
            <directory>addons/sitemap/tests</directory>
            <directory>addons/crawl/tests</directory>
            <directory>addons/lighthouse/tests/Feature</directory>
            <!-- T1 quarantine: mirrors tests/Quarantine.php (cause and owner per file); QuarantineTest keeps both equal. -->
            <exclude>tests/Feature/CheckRecording/MissingAddonTest.php</exclude>
            <exclude>tests/Feature/CheckJourneyTest.php</exclude>
            <exclude>tests/Feature/DemoScenarioTest.php</exclude>
            <exclude>tests/Feature/MonitoringRoutesTest.php</exclude>
            <exclude>tests/Feature/SeederDomainsTest.php</exclude>
        </testsuite>
        <testsuite name="Browser">
            <directory>tests/Browser</directory>
        </testsuite>
    </testsuites>
    <groups>
        <exclude>
            <group>benchmark</group>
        </exclude>
    </groups>
    <source>
        <include>
            <directory>app</directory>
            <directory>addons/uptime/src</directory>
            <directory>addons/performance/src</directory>
            <directory>addons/certificate_health/src</directory>
            <directory>addons/cron/src</directory>
            <directory>addons/channels/src</directory>
            <directory>addons/dns/src</directory>
            <directory>addons/application_health/src</directory>
            <directory>addons/domain/src</directory>
            <directory>addons/sitemap/src</directory>
            <directory>addons/crawl/src</directory>
            <directory>addons/lighthouse/src</directory>
        </include>
        <exclude>
            <directory>.worktrees</directory>
        </exclude>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="array"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="pgsql" force="true"/>
        <env name="DB_DATABASE" value="heptapod_test" force="true"/>
        <env name="DB_TEST_STATEMENT_TIMEOUT" value="30s" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
