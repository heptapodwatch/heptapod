APP_NAME=Heptapod
HEPTAPOD_BROWSER_ENABLED=true
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# LOGIN_LINK_ALLOWED_HOSTS=review-stack.example.test
APP_PORT=8088
# Dev app and Horizon CPU quotas (cores); keep parallel stacks within host capacity.
APP_CPUS=4
HORIZON_CPUS=2
# Dev FrankenPHP PHP worker threads; tune alongside APP_CPUS for expected traffic.
FRANKENPHP_NUM_THREADS=4
VITE_PORT=5188
MAILPIT_PORT=8028
BROWSER_PORT=9334
HEPTAPOD_HEAVY_SLOTS=3
APP_URL="http://localhost:${APP_PORT}"

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=heptapod
DB_USERNAME=heptapod
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
# Dev Compose injects disposable Reverb credentials and its internal publishing address.
# Browser origin defaults to the request origin.
# REVERB_PUBLIC_HOST=
# REVERB_PUBLIC_PORT=
# REVERB_PUBLIC_SCHEME=
# REVERB_PUBLIC_PATH=
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="Heptapod"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Optional maximum personal-access-token age in minutes (unset = no age limit).
# SANCTUM_EXPIRATION=60

# Data retention in days. The 90-day local-time view needs hourly >= 92 and history >= 93 days.
MONITORING_RAW_RETENTION_DAYS=30
MONITORING_ATTEMPT_RETENTION_DAYS=7
MONITORING_HOURLY_ROLLUP_RETENTION_DAYS=92
MONITORING_DAILY_ROLLUP_RETENTION_DAYS=730
MONITORING_HISTORY_RETENTION_DAYS=365
MONITORING_FAILED_JOB_RETENTION_DAYS=7
# Enable only after reviewing heptapod:prune-history --dry-run on the production instance.
MONITORING_HOURLY_ROLLUP_DELETION_ENABLED=false

# Dev-only seams, ignored when APP_ENV=production.
# Throw after the transition of this system issue kind, before its delivery rows (e.g. checks_not_running).
# HEPTAPOD_DEV_FAIL_AFTER_TRANSITION=
# Seconds without a successful send before mail_transport_dead opens (production: always 3600).
# HEPTAPOD_DEV_MAIL_DEAD_AFTER_SECONDS=3600
