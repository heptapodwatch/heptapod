#!/usr/bin/env bash
# Registry I/O only: all bodies are local; unknown calls fail instead of falling
# through to a network-capable curl binary.
set -euo pipefail
url=
output=
head=false
get=false
while [ "$#" -gt 0 ]; do
    case "$1" in
        --fail|--fail-with-body|--silent|--show-error) shift ;;
        --head) head=true; shift ;;
        --get) get=true; shift ;;
        --user|--data-urlencode|-H) shift 2 ;;
        -o) output=$2; shift 2 ;;
        fixture://*) url=$1; shift ;;
        *) printf 'Unexpected fixture curl argument: %s\n' "$1" >&2; exit 1 ;;
    esac
done
if [ "$url" = "$RETENTION_TOKEN_URL" ] && [ "$get" = true ]; then
    file="$RETENTION_FIXTURE/token.json"
elif [ "$url" = "$RETENTION_REGISTRY_URL/v2/$RETENTION_TEST_OWNER/$RETENTION_TEST_PACKAGE/manifests/main" ] && [ "$head" = true ]; then
    file="$RETENTION_FIXTURE/main-headers.txt"
else
    file=
    for manifest in "$RETENTION_FIXTURE"/manifests/*.json; do
        digest="sha256:$(sha256sum "$manifest" | cut -d ' ' -f 1)"
        if [ "$url" = "$RETENTION_REGISTRY_URL/v2/$RETENTION_TEST_OWNER/$RETENTION_TEST_PACKAGE/manifests/$digest" ]; then
            file=$manifest
            break
        fi
    done
    if [ -z "$file" ] || [ "$head" = true ] || [ "$get" = true ]; then
        echo "No curl fixture for URL: $url" >&2
        exit 1
    fi
fi
printf 'Local registry fixture: %s\n' "$url" >&2
if [ -n "$output" ]; then
    cp "$file" "$output"
else
    cat "$file"
fi
