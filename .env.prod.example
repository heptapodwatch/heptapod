APP_NAME=Heptapod
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://monitor.example.com
SERVER_NAME=monitor.example.com
HTTP_PORT=80
HTTPS_PORT=443
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
LOG_CHANNEL=stderr
LOG_STDERR_FORMATTER=Monolog\Formatter\JsonFormatter
LOG_LEVEL=info
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Optional extra trusted browser hostnames (no scheme or port); wildcard * is rejected.
REVERB_APP_ALLOWED_ORIGINS=
REVERB_APP_MAX_CONNECTIONS=500
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=heptapod
DB_USERNAME=heptapod
DB_PASSWORD=
# Per-statement PostgreSQL limits. Administrative CLI and migrations are unbounded.
DB_WEB_STATEMENT_TIMEOUT=10s
DB_BACKGROUND_STATEMENT_TIMEOUT=120s
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=redis
# One crawl worker on 4 GiB hosts; on >=8 GiB set 2 and HORIZON_MEMORY_LIMIT=2990m.
# The worker refuses to start when HORIZON_MEMORY_LIMIT is below its topology's budget (heptapod:worker-memory).
HEPTAPOD_CRAWL_CONCURRENCY=1
HORIZON_MEMORY_LIMIT=1990m
# Crawl worker PHP memory limit (MiB). The installer writes 512 with HORIZON_MEMORY_LIMIT=1670m on hosts below 6 GiB.
HEPTAPOD_CRAWL_MEMORY_LIMIT_MB=768
# Broken-links and mixed-content execution deadline, 1..1200 seconds.
HEPTAPOD_CRAWL_TIMEOUT_SECONDS=1200
# Per-origin resource and external status URL budgets (each 1..25000).
HEPTAPOD_CRAWL_MAX_STATUS_URLS=10000
FILESYSTEM_DISK=local

# The log mailer redacts capability links. Without SMTP, use heptapod:user:access-link to issue an invite or reset link.
MAIL_MAILER=log
# Exact private delivery hosts/IPs only, comma-separated. No wildcards/CIDR; metadata and link-local stay blocked.
# HEPTAPOD_DELIVERY_PRIVATE_HOSTS=
MAIL_FROM_ADDRESS=hello@example.com
# Display name of the mail sender.
MAIL_FROM_NAME="Heptapod"

# Separate volume. Copy encrypted archives off-host; a local disk is not disaster recovery.
BACKUP_DISK=backups
BACKUP_ARCHIVE_PASSWORD=
# Lifecycle archives have a separate directory and expiry owner; referenced generations are always kept.
HEPTAPOD_UPGRADE_BACKUP_KEEP=3
# Daily backup retention defaults. Policy changes are opt-in.
BACKUP_KEEP_ALL_DAYS=7
BACKUP_KEEP_DAILY_DAYS=16
BACKUP_KEEP_WEEKLY_WEEKS=8
BACKUP_KEEP_MONTHLY_MONTHS=4
BACKUP_KEEP_YEARLY_YEARS=2
BACKUP_MAX_MEGABYTES=5000
# Optional PostgreSQL data mount visible to the app; configured unreadable paths raise a system issue.
# HEPTAPOD_POSTGRES_DATA_PATH=
# Optional external dead-man URL. Empty means heartbeat is disabled.
INSTANCE_HEARTBEAT_URL=

# Hourly rollups older than MONITORING_HOURLY_ROLLUP_RETENTION_DAYS (92) are kept while this is false, so their table grows without bound.
# Enable after reviewing `php artisan heptapod:prune-history --dry-run` counts on this instance.
# MONITORING_HOURLY_ROLLUP_DELETION_ENABLED=false
# check_not_fresh opens after MULTIPLIER x the check interval without a result, clamped per queue to MIN..MAX seconds.
# MIN must cover the queue's claim and running lease (validated at boot) and must not exceed MAX.
# HEPTAPOD_FRESHNESS_INTERVAL_MULTIPLIER=3
# HEPTAPOD_FRESHNESS_FAST_MIN_SECONDS=900
# HEPTAPOD_FRESHNESS_FAST_MAX_SECONDS=21600
# HEPTAPOD_FRESHNESS_CRAWL_MIN_SECONDS=7200
# HEPTAPOD_FRESHNESS_CRAWL_MAX_SECONDS=21600
# HEPTAPOD_FRESHNESS_BROWSER_MIN_SECONDS=7200
# HEPTAPOD_FRESHNESS_BROWSER_MAX_SECONDS=21600

# Browser health probes use these base URLs with /health appended when browser services are enabled.
LIGHTHOUSE_URL=http://lighthouse:3000
GOTENBERG_URL=http://gotenberg:3000
VITE_APP_NAME="${APP_NAME}"
# Reverb uses runtime configuration; no VITE_REVERB_* build variables.
# REVERB_PUBLIC_HOST=
# REVERB_PUBLIC_PORT=
# REVERB_PUBLIC_SCHEME=
# REVERB_PUBLIC_PATH=

# heptapod.uptime.max_response_bytes: wire and decoded response limit (10 MiB).
UPTIME_MAX_RESPONSE_BYTES=10485760

# Installer keeps browser services on unless --without-browser is supplied.
COMPOSE_PROFILES=browser
HEPTAPOD_BROWSER_ENABLED=true
# Comma-separated IPs/CIDRs. Never trust arbitrary Internet clients.
TRUSTED_PROXIES=
# Persistent application files. S3 adapter ships in the image.
HEPTAPOD_STORAGE_DISK=local
